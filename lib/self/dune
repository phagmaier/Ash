(library
 (name ash_self)
 (public_name ash.self)
 (libraries ash.core ash.syntax ash.runtime)
 (flags
  (:standard -w +a-4-9-40-41-42-44-45-70 -warn-error +8+11+26+27+32..39)))

; The interpreter is written in Ash, so it lives in a `.ash` file that the
; parser and the reader both see as ordinary source, and is embedded here rather
; than read from disk at run time: a test that could not find its subject would
; be a worse failure than one that disagrees with it.
(rule
 (target self_source.ml)
 (deps eval.ash)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "(* Generated from eval.ash by the rule in lib/self/dune. *)\nlet text = {ash|")
    (cat eval.ash)
    (echo "|ash}\n")))))
