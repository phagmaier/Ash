Documented programs
--------------------------------------------------------------------------

== §4.1 fact ==
  | fn fact(n) =
  |   if n == 0 then 1
  |   else n * fact(n - 1)
  | fact(5)
  =>
(letrec ((fact (lam (n) (if (app (var ==) (var n) (lit 0)) (lit 1) (app (var *) (var n) (app (var fact) (app (var -) (var n) (lit 1)))))))) (app (var fact) (lit 5)))

== §4.1 classify ==
  | fn classify(n) = {
  |   let m = n % 3
  |   if m == 0 then 'zero else if m == 1 then 'one else 'two
  | }
  =>
(letrec ((classify (lam (n) (let m (app (var %) (var n) (lit 3)) (if (app (var ==) (var m) (lit 0)) (lit 'zero) (if (app (var ==) (var m) (lit 1)) (lit 'one) (lit 'two))))))) (lit unit))

== §4.2 length ==
  | fn length(xs) =
  |   match xs {
  |     []      -> 0
  |     _ :: ys -> 1 + length(ys)
  |   }
  =>
(letrec ((length (lam (xs) (let scrutinee (var xs) (let next_clause (lam () (let next_clause (lam () (app (var match_error) (var scrutinee))) (if (app (var list?) (var scrutinee)) (if (app (var empty?) (var scrutinee)) (app (var next_clause)) (let head1 (app (var head) (var scrutinee)) (let tail1 (app (var tail) (var scrutinee)) (let ys (var tail1) (app (var +) (lit 1) (app (var length) (var ys))))))) (app (var next_clause))))) (if (app (var list?) (var scrutinee)) (if (app (var empty?) (var scrutinee)) (lit 0) (app (var next_clause))) (app (var next_clause)))))))) (lit unit))

== mutual recursion in one group ==
  | fn even(n) = if n == 0 then true else odd(n - 1)
  | fn odd(n) = if n == 0 then false else even(n - 1)
  =>
(letrec ((even (lam (n) (if (app (var ==) (var n) (lit 0)) (lit #t) (app (var odd) (app (var -) (var n) (lit 1)))))) (odd (lam (n) (if (app (var ==) (var n) (lit 0)) (lit #f) (app (var even) (app (var -) (var n) (lit 1))))))) (lit unit))

== alternatives share one body ==
  | match [7] {
  |   [x] | x :: [] -> x + 1
  |   _ -> 0
  | }
  =>
(let scrutinee (app (var list) (lit 7)) (let next_clause (lam () (let next_clause (lam () (app (var match_error) (var scrutinee))) (lit 0))) (let clause_body (lam (x) (app (var +) (var x) (lit 1))) (let next_alternative (lam () (if (app (var list?) (var scrutinee)) (if (app (var empty?) (var scrutinee)) (app (var next_clause)) (let head1 (app (var head) (var scrutinee)) (let tail1 (app (var tail) (var scrutinee)) (let x (var head1) (if (app (var list?) (var tail1)) (if (app (var empty?) (var tail1)) (app (var clause_body) (var x)) (app (var next_clause))) (app (var next_clause))))))) (app (var next_clause)))) (if (app (var list?) (var scrutinee)) (if (app (var empty?) (var scrutinee)) (app (var next_alternative)) (let head1 (app (var head) (var scrutinee)) (let tail1 (app (var tail) (var scrutinee)) (let x (var head1) (if (app (var list?) (var tail1)) (if (app (var empty?) (var tail1)) (app (var clause_body) (var x)) (app (var next_alternative))) (app (var next_alternative))))))) (app (var next_alternative)))))))

== closure-visible mutation ==
  | var c = 0
  | fn bump() = c := c + 1
  | bump()
  | c
  =>
(let c (lit 0) (letrec ((bump (lam () (set c (app (var +) (var c) (lit 1)))))) (let _ (app (var bump)) (var c))))

== §5.3 the tracing demo ==
  | fn fib(n) = if n < 2 then n else fib(n - 1) + fib(n - 2)
  | up {
  |   let base = eval
  |   eval := fn(e, r, k) -> { print(code_view(e)); base(e, r, k) }
  | }
  | fib(3)
  =>
(letrec ((fib (lam (n) (if (app (var <) (var n) (lit 2)) (var n) (app (var +) (app (var fib) (app (var -) (var n) (lit 1))) (app (var fib) (app (var -) (var n) (lit 2)))))))) (let _ (app (reifier (exp env cont) (let eval (app (var meta_eval)) (let apply (app (var meta_apply)) (let global (app (var meta_global)) (let level (app (var tower_level)) (app (var resume) (var cont) (let base (app (var open_deref) (var eval)) (app (var open_set) (var eval) (lam (e r k) (let _ (app (var print) (app (var code_view) (var e))) (app (var base) (var e) (var r) (var k))))))))))))) (app (var fib) (lit 3))))

--------------------------------------------------------------------------
Provenance: which rewrite invented which node
--------------------------------------------------------------------------
  1 + 2                                    desugar/operator
  1; 2                                     desugar/seq
  let x = 1                                desugar/unit
  fn f() = 1                               desugar/fn desugar/unit
  open fn f() = 1                          desugar/open desugar/unit
  [1]                                      desugar/list
  true && false                            desugar/and
  match 1 { _ -> 2 }                       desugar/match
  `{ ${`{ 1 }} }                           desugar/quote
  up { 1 }                                 desugar/up

