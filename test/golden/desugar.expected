Ash surface-to-Core desugaring — golden output
Binder names are chosen by the Core printer, not by the desugarer.

--------------------------------------------------------------------------
Derived sugar, one construct at a time
--------------------------------------------------------------------------
  1; 2                                     => (let _ (lit 1) (lit 2))
  let x = 1; x                             => (let x (lit 1) (var x))
  var x = 1; x := 2                        => (let x (lit 1) (set x (lit 2)))
  fn f(n) = n                              => (letrec ((f (lam (n) (var n)))) (lit unit))
  fn(x) -> x                               => (lam (x) (var x))
  true && false                            => (if (lit #t) (lit #f) (lit #f))
  true || false                            => (if (lit #t) (lit #t) (lit #f))
  !true                                    => (app (var not) (lit #t))
  0 - 1                                    => (app (var -) (lit 0) (lit 1))
  let x = 1; -x                            => (let x (lit 1) (app (var -) (lit 0) (var x)))
  []                                       => (lit nil)
  [1, 2]                                   => (app (var list) (lit 1) (lit 2))
  1 :: [2]                                 => (app (var cons) (lit 1) (app (var list) (lit 2)))
  [1] |> length                            => (app (var length) (app (var list) (lit 1)))
  1 |> cons([])                            => (app (var cons) (lit 1) (lit nil))
  { let x = 1; x + 1 }                     => (let x (lit 1) (app (var +) (var x) (lit 1)))
  if true then 1 else 2                    => (if (lit #t) (lit 1) (lit 2))
  1 == 2                                   => (app (var ==) (lit 1) (lit 2))
  1 + 2 * 3                                => (app (var +) (lit 1) (app (var *) (lit 2) (lit 3)))
  open fn f(n) = f(n)                      => (let f (app (var open_cell) (lit unit)) (let _ (app (var open_set) (var f) (lam (n) (app (app (var open_deref) (var f)) (var n)))) (lit unit)))
  open fn f() = 1; f := fn() -> 2          => (let f (app (var open_cell) (lit unit)) (let _ (app (var open_set) (var f) (lam () (lit 1))) (app (var open_set) (var f) (lam () (lit 2)))))
  `{ 1 + 2 }                               => (quote (app (var +) (lit 1) (lit 2)))
  let a = `{ 1 }; `{ ${a} + 2 }            => (let a (quote (lit 1)) (app (var code_splice) (quote (app (var +) (var splice) (lit 2))) (quote (var splice)) (var a)))
  match `{ 1 } { Lit(n) -> n; _ -> 0 }     => (let scrutinee (quote (lit 1)) (let next_clause (lam () (let next_clause (lam () (app (var match_error) (var scrutinee))) (lit 0))) (if (app (var code?) (var scrutinee)) (let code_view1 (app (var code_view) (var scrutinee)) (if (app (var list?) (var code_view1)) (if (app (var empty?) (var code_view1)) (app (var next_clause)) (let head1 (app (var head) (var code_view1)) (let tail1 (app (var tail) (var code_view1)) (if (app (var ==) (var head1) (lit 'Lit)) (if (app (var list?) (var tail1)) (if (app (var empty?) (var tail1)) (app (var next_clause)) (let head2 (app (var head) (var tail1)) (let tail2 (app (var tail) (var tail1)) (let n (var head2) (if (app (var list?) (var tail2)) (if (app (var empty?) (var tail2)) (var n) (app (var next_clause))) (app (var next_clause))))))) (app (var next_clause))) (app (var next_clause)))))) (app (var next_clause)))) (app (var next_clause)))))
  match `{ 1 + 0 } { `{ ${a} + 0 } -> a; _ -> `{ 0 } } => (let scrutinee (quote (app (var +) (lit 1) (lit 0))) (let next_clause (lam () (let next_clause (lam () (app (var match_error) (var scrutinee))) (quote (lit 0)))) (let code_match1 (app (var code_match) (quote (app (var +) (var splice) (lit 0))) (var scrutinee) (quote (var splice))) (if (app (var list?) (var code_match1)) (if (app (var empty?) (var code_match1)) (app (var next_clause)) (let head1 (app (var head) (var code_match1)) (let tail1 (app (var tail) (var code_match1)) (if (app (var list?) (var head1)) (if (app (var empty?) (var head1)) (app (var next_clause)) (let head2 (app (var head) (var head1)) (let tail2 (app (var tail) (var head1)) (let a (var head2) (if (app (var list?) (var tail2)) (if (app (var empty?) (var tail2)) (if (app (var list?) (var tail1)) (if (app (var empty?) (var tail1)) (var a) (app (var next_clause))) (app (var next_clause))) (app (var next_clause))) (app (var next_clause))))))) (app (var next_clause)))))) (app (var next_clause))))))
  up { 1 }                                 => (app (reifier (exp env cont) (let eval (app (var meta_eval)) (let apply (app (var meta_apply)) (let global (app (var meta_global)) (let level (app (var tower_level)) (app (var resume) (var cont) (lit 1))))))))
  up { eval := eval }                      => (app (reifier (exp env cont) (let eval (app (var meta_eval)) (let apply (app (var meta_apply)) (let global (app (var meta_global)) (let level (app (var tower_level)) (app (var resume) (var cont) (app (var open_set) (var eval) (app (var open_deref) (var eval))))))))))

